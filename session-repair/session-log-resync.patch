+  it('skips stale duplicate events left by an interrupted rewrite and resyncs', () => {
+    const header = Buffer.from(`${JSON.stringify(toHeaderLine(meta('scanner-rewrite-duplicates')))}\n`)
+    const events = oneTurnLog()
+    const stale = [events[2], events[3]] // seq 2..3 re-emitted by the interrupted rewrite
+    const rows = [...events.slice(0, 4), ...stale, ...events.slice(4)]
+    const scanner = new SessionLogScanner(header)
+    scanner.write(Buffer.from(rows.map(event => JSON.stringify(event)).join('\n') + '\n'))
+    const result = scanner.finish()
+    expect(result.events).toEqual(events)
+    expect(result.committedBytes).toBe(
+      header.length + rows.map(event => JSON.stringify(event)).join('\n').length + 1,
+    )
+  })
